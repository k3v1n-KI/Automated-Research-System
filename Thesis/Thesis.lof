\contentsline {figure}{\numberline {4.1}{\ignorespaces The Three-Layer Event-Sourced Architecture of Pathways.}}{53}{figure.4.1}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces The Pathways Search Interface (Phase 1), demonstrating the explicit visual separation of algorithmic Fit Scores and temporal Trust Scores.}}{55}{figure.4.2}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Phase 1 filter-extraction pipeline. Deterministic rules and aliases are applied first; semantic matching and the constrained LLM fallback operate only on unresolved or ambiguous residue.}}{56}{figure.4.3}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces The Resource Detail Interface (Phase 2), featuring inline, zero-friction verification and flagging controls for highly mutable data fields.}}{58}{figure.4.4}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces The Ask Board and ARS Job Queue (Phase 3), illustrating the asynchronous delegation of flagged resources to the autonomous AI background worker.}}{59}{figure.4.5}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces The Resolution Interface (Phase 4), enabling human operators to seamlessly validate and accept the ARS's autonomously discovered data updates.}}{60}{figure.4.6}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces The socio-technical flywheel integrating human validation with the ARS background worker.}}{60}{figure.4.7}%
